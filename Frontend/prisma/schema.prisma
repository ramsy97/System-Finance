datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  FINANCE
  ACCOUNTING
  MANAGER
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  VENDOR
}

enum InvoiceType {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  CASH_IN
  CASH_OUT
  TRANSFER
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  VIRTUAL_ACCOUNT
  CREDIT_CARD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String
  name             String
  role             Role        @default(VIEWER)
  isActive         Boolean     @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  auditLogs        AuditLog[]
  approvedInvoices Invoice[]   @relation("InvoiceApproval")
  approvedTransactions  Transaction[] @relation("TransactionApproval")
  createdTransactions   Transaction[] @relation("TransactionCreator")
}

model Account {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  type          AccountType
  balance       Decimal        @default(0.00) @db.Decimal(15, 2)
  description   String?
  isSystem      Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bankKas       BankKas?
  journalItems  JournalItem[]
  transactions  Transaction[]  @relation("SourceAccount")
  targetTrans   Transaction[]  @relation("TargetAccount")
}

model BankKas {
  id            String         @id @default(uuid())
  accountId     String         @unique
  account       Account        @relation(fields: [accountId], references: [id])
  bankName      String
  accountNumber String
  holderName    String
  status        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mutations     BankMutation[]
}

model Contact {
  id           String         @id @default(uuid())
  type         ContactType
  name         String
  email        String?
  phone        String?
  address      String?
  taxId        String?
  balance      Decimal        @default(0.00) @db.Decimal(15, 2)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoices     Invoice[]
  transactions Transaction[]
  journalItems JournalItem[]
}

model Project {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique
  budget       Decimal        @db.Decimal(15, 2)
  description  String?
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transactions Transaction[]
  journalItems JournalItem[]
  budgets      Budget[]
}

model Department {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  transactions Transaction[]
  journalItems JournalItem[]
  budgets      Budget[]
}

model Category {
  id          String         @id @default(uuid())
  name        String
  type        AccountType
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  transactions Transaction[]
  budgets      Budget[]
}

model Budget {
  id           String      @id @default(uuid())
  year         Int
  month        Int?
  amount       Decimal     @db.Decimal(15, 2)
  spent        Decimal     @default(0.00) @db.Decimal(15, 2)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Invoice {
  id               String         @id @default(uuid())
  invoiceNumber    String         @unique
  type             InvoiceType
  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id])
  date             DateTime
  dueDate          DateTime
  status           InvoiceStatus  @default(DRAFT)
  subtotal         Decimal        @db.Decimal(15, 2)
  taxAmount        Decimal        @default(0.00) @db.Decimal(15, 2)
  discountAmount   Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount      Decimal        @db.Decimal(15, 2)
  amountPaid       Decimal        @default(0.00) @db.Decimal(15, 2)
  remainingAmount  Decimal        @db.Decimal(15, 2)
  isRecurring      Boolean        @default(false)
  notes            String?
  paymentProofUrl  String?
  approvalStatus   ApprovalStatus @default(PENDING)
  approvedById     String?
  approvedBy       User?          @relation("InvoiceApproval", fields: [approvedById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            InvoiceItem[]
}

model InvoiceItem {
  id          String      @id @default(uuid())
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal     @db.Decimal(15, 2)
  amount      Decimal     @db.Decimal(15, 2)
}

model Transaction {
  id              String         @id @default(uuid())
  transactionNo   String         @unique
  type            TransactionType
  date            DateTime
  amount          Decimal        @db.Decimal(15, 2)
  accountId       String
  account         Account        @relation("SourceAccount", fields: [accountId], references: [id])
  targetAccountId String?
  targetAccount   Account?       @relation("TargetAccount", fields: [targetAccountId], references: [id])
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  contactId       String?
  contact         Contact?       @relation(fields: [contactId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  paymentMethod   PaymentMethod  @default(CASH)
  referenceNo     String?
  description     String?
  receiptUrl      String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?          @relation("TransactionApproval", fields: [approvedById], references: [id])
  createdById     String
  createdBy       User           @relation("TransactionCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  mutations       BankMutation[]
}

model JournalEntry {
  id                String        @id @default(uuid())
  entryNumber       String        @unique
  date              DateTime
  type              String        @default("GENERAL")
  description       String?
  isSystemGenerated Boolean       @default(true)
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             JournalItem[]
}

model JournalItem {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0.00) @db.Decimal(15, 2)
  credit         Decimal      @default(0.00) @db.Decimal(15, 2)
  description    String?
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
}

model BankMutation {
  id            String       @id @default(uuid())
  bankKasId     String
  bankKas       BankKas      @relation(fields: [bankKasId], references: [id])
  date          DateTime
  amount        Decimal      @db.Decimal(15, 2)
  type          String
  description   String?
  isReconciled  Boolean      @default(false)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CompanySettings {
  id             String   @id @default("default")
  name           String   @default("Fintech Corp")
  logoUrl        String?
  address        String?
  taxId          String?
  taxRate        Decimal  @default(11.00) @db.Decimal(5, 2)
  invoicePrefix  String   @default("INV")
  emailSmtpHost  String?
  emailSmtpPort  Int?
  emailSmtpUser  String?
  emailSmtpPass  String?
  waApiUrl       String?
  waApiKey       String?
  updatedAt      DateTime @updatedAt
}
